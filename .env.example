# FootAR local configuration — copy to `.env` and adjust for your machine.
# The web backend reads this file at startup (web/backend/config.py).

# Python executable used to run the inference processor (src/main_seg.py).
# It must have torch, ultralytics and supervision installed.
# Resolution order: FOOTAR_PYTHON env var > this file > auto-detected venvs > backend Python.
FOOTAR_PYTHON=C:\VS-Projects\FootAR\FootAR_old\.venv\Scripts\python.exe
